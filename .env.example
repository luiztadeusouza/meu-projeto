# IPs permitidos para acessar o servidor de dev por outros dispositivos na rede Wi-Fi.
# Separe múltiplos IPs por vírgula. Deixe vazio para desabilitar.
# Exemplo: ALLOWED_DEV_ORIGINS=192.168.1.100,192.168.1.101
ALLOWED_DEV_ORIGINS=

# Número de WhatsApp para o botão de contato (somente dígitos, com DDI).
# Exemplo: NEXT_PUBLIC_WHATSAPP_NUMBER=5534999999999
NEXT_PUBLIC_WHATSAPP_NUMBER=
