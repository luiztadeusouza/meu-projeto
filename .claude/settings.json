{
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.*.local)",
      "Read(./.env.development)",
      "Read(./.env.production)",
      "Read(./.mcp.json)",
      "Read(~/.claude.json)",
      "Bash(cat .env)",
      "Bash(cat .env.*)",
      "Bash(cat .mcp.json)",
      "Bash(cat ~/.claude.json)",
      "Bash(type .env)",
      "Bash(type .mcp.json)",
      "Bash(printenv:*)",
      "Bash(env)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|clear|resume",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/init.js"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/session-stop.js",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
